{
  "modFormat": 1,
  "id": "garden-workshop",
  "name": "苔光花园",
  "version": "1.0.0",
  "description": "一间随合成次数生长的小花房。含固定配方、玩法按钮、主题、台面、卡面、卡背与音效。",
  "theme": "用自然与园艺的想象解释材料之间的关系，优先产生适合苔光花园的小物件。",
  "cards": [
    {
      "name": "种子",
      "emoji": "🌰",
      "category": "自然",
      "description": "一颗等待萌芽的种子。"
    },
    {
      "name": "幼苗",
      "emoji": "🌱",
      "category": "自然",
      "description": "刚刚探出泥土的新芽。"
    },
    {
      "name": "花园",
      "emoji": "🌷",
      "category": "自然",
      "description": "细心照料的小小天地。"
    }
  ],
  "startingCards": [
    "种子"
  ],
  "recipes": [
    {
      "ingredients": [
        "水",
        "土"
      ],
      "result": "幼苗"
    },
    {
      "ingredients": [
        "幼苗",
        "木"
      ],
      "result": "花园"
    }
  ],
  "assets": {
    "cloth": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACAAAAAgCAIAAAD8GO2jAAAAPklEQVR4nGPQC/LEiuwyorEiUtUzjFowasEQsIBaBuFSP2rBqAVDwQKaZ7RRC0YtGAIW0DyjjVowasHgtwAAIY6ULiyqyZEAAAAASUVORK5CYII=",
    "chime": "data:audio/wav;base64,"
  },
  "tabletops": [
    {
      "id": "moss",
      "name": "苔绿台布",
      "color": "#dce9db",
      "gridColor": "#55766130",
      "image": "cloth"
    }
  ],
  "skins": [
    {
      "id": "leaf",
      "name": "叶脉",
      "face": "#eff5e4",
      "ink": "#294d3c",
      "border": "#527864",
      "accent": "#728d35",
      "image": "cloth"
    }
  ],
  "cardBacks": [
    {
      "id": "garden",
      "name": "花房卡背",
      "face": "#244b40",
      "ink": "#edf2d8",
      "border": "#c1d28d",
      "accent": "#afc67a",
      "image": "cloth"
    }
  ],
  "sounds": {
    "lift": "chime",
    "think": "chime",
    "discovery": "chime",
    "repeat": "chime",
    "failure": "chime"
  },
  "actions": [
    {
      "id": "harvest",
      "name": "收一颗种子",
      "description": "查看照料次数，并收下种子。"
    }
  ],
  "script": "registerMod({\n  resolve(ctx) {\n    if (ctx.ingredients.length === 2 && ctx.ingredients.every(c => c.name === '种子')) {\n      return { card: {name:'双生芽',emoji:'🌿',category:'自然',description:'两颗种子一起醒来了。'} };\n    }\n  },\n  transform(ctx) {\n    if (ctx.result.name === '花园') return {card:{...ctx.result,description:'亲手合出的花园，留下了照料的痕迹。'}};\n  },\n  afterCombine(ctx) {\n    return {state:{...ctx.state,combinations:(ctx.state.combinations||0)+1}};\n  },\n  actions: {\n    harvest(ctx) {\n      const visits=(ctx.state.visits||0)+1;\n      return {cards:[{name:'种子',emoji:'🌰',category:'自然',description:'一颗等待萌芽的种子。'}],state:{...ctx.state,visits},message:'已照料花园 '+visits+' 次，完成合成 '+(ctx.state.combinations||0)+' 次。'};\n    }\n  }\n});"
}